module Obsidian
  module Import
    module Adapters
      class GitHub < Base
        @gh: GhRunner?

        BASE_URL: String

        def initialize: (?gh: GhRunner?, **untyped kwargs) -> void

        def search: (query: String) -> Array[Resource]

        def lookup: (id: String) -> Resource

        def normalize: (record: untyped) -> Resource

        private

        def fetch: (String path, **untyped params) -> untyped

        def gh: () -> GhRunner

        def cache_key: (String path, Hash[untyped, untyped] params) -> String

        def base_url: () -> String

        def request_headers: () -> Hash[String, untyped]
      end
    end
  end
end
